---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartShell from "../components/ChartShell.astro";
---

<BaseLayout
  title="Movers"
  description="Biggest price drops and new entrants since the last snapshot."
>
  <div class="grid gap-10">
    <header class="space-y-2">
      <h1 class="m-0 text-[clamp(1.75rem,3vw,2.5rem)] font-semibold tracking-[-0.02em]">
        Movers
      </h1>
      <p class="m-0 text-[var(--muted)] max-w-2xl">
        Week-over-week price drops (signal green) and increases (danger red),
        plus models that appeared for the first time.
      </p>
    </header>

    <ChartShell
      takeaway="The loudest cuts and the newest names since the previous snapshot."
      keyNumber="—"
      keyNumberLabel="Biggest drop"
      source="Source: OpenRouter weekly snapshots (SGDev)"
    />
  </div>
</BaseLayout>
