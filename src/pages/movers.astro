---
import BaseLayout from "../layouts/BaseLayout.astro";
import MoversView from "../components/MoversView";
import { loadMeta, loadMovers } from "../lib/data";

const meta = loadMeta();
const data = loadMovers();
---

<BaseLayout
  title="Movers"
  description="Biggest LLM price drops, increases, and new entrants since the previous snapshot."
  lastUpdated={meta.lastUpdated}
>
  <div class="grid gap-8">
    <header class="space-y-2">
      <p class="font-mono m-0 text-[11px] uppercase tracking-[0.16em] text-[var(--muted)]">
        Weekly delta · Price drops &amp; new entrants
      </p>
      <h1 class="m-0 text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.025em]">
        Movers
      </h1>
    </header>

    <MoversView client:load data={data} />
  </div>
</BaseLayout>
