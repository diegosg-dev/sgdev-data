---
import BaseLayout from "../layouts/BaseLayout.astro";
import DollarBuysChart from "../components/DollarBuysChart";
import { loadFrontier, loadMeta } from "../lib/data";

const meta = loadMeta();
const frontierData = loadFrontier();
---

<BaseLayout
  title="What $1 buys you"
  description="Tokens and task counts per $1 USD across LLM models for preset workloads."
  lastUpdated={meta.lastUpdated}
>
  <div class="grid gap-8">
    <header class="space-y-2">
      <p class="font-mono m-0 text-[11px] uppercase tracking-[0.16em] text-[var(--muted)]">
        Unit economics · Preset workloads
      </p>
      <h1 class="m-0 text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.025em]">
        What $1 buys you
      </h1>
    </header>

    <DollarBuysChart client:load frontierData={frontierData} />
  </div>
</BaseLayout>
