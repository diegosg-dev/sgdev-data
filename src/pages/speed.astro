---
import BaseLayout from "../layouts/BaseLayout.astro";
import SpeedIntelligenceChart from "../components/SpeedIntelligenceChart";
import { loadMeta, loadSpeedIntelligence } from "../lib/data";

const meta = loadMeta();
const data = loadSpeedIntelligence();
---

<BaseLayout
  title="Benchmarks & Time per Task"
  description="Artificial Analysis time per task (E2E), cost per task, and 7 domain benchmarks (Intelligence, Engineering, Economics, Finance, Strategy, Legal, Healthcare)."
  lastUpdated={meta.lastUpdated}
>
  <div class="grid gap-8">
    <header class="space-y-2">
      <p class="font-mono m-0 text-[11px] uppercase tracking-[0.16em] text-[var(--muted)]">
        Artificial Analysis API v2 · Time per Task &amp; 7 Benchmarks
      </p>
      <h1 class="m-0 text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.025em]">
        Time per task &amp; benchmarks
      </h1>
    </header>

    <SpeedIntelligenceChart client:load data={data} />
  </div>
</BaseLayout>
