---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimelineChart from "../components/TimelineChart";
import { loadMeta, loadTimeline } from "../lib/data";

const meta = loadMeta();
const data = loadTimeline();
---

<BaseLayout
  title="Release & context timeline"
  description="Models by release date and context window growth over time."
  lastUpdated={meta.lastUpdated}
>
  <div class="grid gap-8">
    <header class="space-y-2">
      <p class="font-mono m-0 text-[11px] uppercase tracking-[0.16em] text-[var(--muted)]">
        Release cadence · Context growth
      </p>
      <h1 class="m-0 text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.025em]">
        Release &amp; context timeline
      </h1>
    </header>

    <TimelineChart client:load data={data} />
  </div>
</BaseLayout>
