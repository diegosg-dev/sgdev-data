---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartShell from "../components/ChartShell.astro";
---

<BaseLayout
  title="Release & context timeline"
  description="Models by first-seen date and context window growth."
>
  <div class="grid gap-10">
    <header class="space-y-2">
      <h1 class="m-0 text-[clamp(1.75rem,3vw,2.5rem)] font-semibold tracking-[-0.02em]">
        Release &amp; context timeline
      </h1>
      <p class="m-0 text-[var(--muted)] max-w-2xl">
        First-seen dates from our snapshots, plotted against reported context
        window size.
      </p>
    </header>

    <ChartShell
      takeaway="Context windows keep climbing; watch when new models first enter our feed."
      keyNumber="—"
      keyNumberLabel="Largest context"
      source="Source: OpenRouter context fields · SGDev first-seen"
    />
  </div>
</BaseLayout>
