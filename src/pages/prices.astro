---
import BaseLayout from "../layouts/BaseLayout.astro";
import PricesChart from "../components/PricesChart";
import { loadMeta, loadPricesHistory } from "../lib/data";

const meta = loadMeta();
const data = loadPricesHistory();
---

<BaseLayout
  title="Prices over time"
  description="Per-model API prices and cheapest price for a given LMArena quality floor."
  lastUpdated={meta.lastUpdated}
>
  <div class="grid gap-8">
    <header class="space-y-2">
      <p class="font-mono m-0 text-[11px] uppercase tracking-[0.16em] text-[var(--muted)]">
        Price history · 3:1 input:output blended
      </p>
      <h1 class="m-0 text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.025em]">
        Prices over time
      </h1>
    </header>

    <PricesChart client:load data={data} />
  </div>
</BaseLayout>
