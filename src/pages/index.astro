---
import BaseLayout from "../layouts/BaseLayout.astro";
import FrontierDashboard from "../components/FrontierDashboard";
import { loadFrontier, loadMeta, loadPricesHistory } from "../lib/data";

const meta = loadMeta();
const frontierData = loadFrontier();
const pricesHistory = loadPricesHistory();
---

<BaseLayout
  title="SGDev LLM Data"
  description="Price vs quality frontier for LLMs — find the good-enough model for your budget."
  lastUpdated={meta.lastUpdated}
>
  <div class="grid gap-10">
    <header class="grid gap-4 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8 space-y-3">
        <p class="font-mono m-0 text-[11px] uppercase tracking-[0.16em] text-[var(--muted)]">
          Terminal Editorial · LLM market scan
        </p>
        <h1 class="m-0 text-[clamp(2rem,4.5vw,3.25rem)] font-semibold leading-[1.05] tracking-[-0.03em]">
          Price vs quality.<br />
          <span class="text-[var(--signal)]">Find the frontier.</span>
        </h1>
        <p class="m-0 max-w-xl text-[var(--muted)] leading-relaxed">
          Weekly snapshots of OpenRouter prices joined to LMArena style-control
          scores and Artificial Analysis speed &amp; intelligence benchmarks.
        </p>
      </div>
      <div class="md:col-span-4 md:text-right space-y-1">
        <p class="font-mono m-0 text-[10px] uppercase tracking-[0.12em] text-[var(--muted)]">
          Latest snapshot
        </p>
        <p class="font-mono m-0 text-sm text-[var(--signal)]">
          {meta.snapshotDate} · {meta.matchedCount} matched models
        </p>
      </div>
    </header>

    <FrontierDashboard
      client:load
      frontierData={frontierData}
      pricesHistory={pricesHistory}
    />
  </div>
</BaseLayout>
