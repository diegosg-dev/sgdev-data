---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpenVsClosedChart from "../components/OpenVsClosedChart";
import { loadMeta, loadOpenVsClosed } from "../lib/data";

const meta = loadMeta();
const data = loadOpenVsClosed();
---

<BaseLayout
  title="Open vs closed"
  description="Best open-weights vs best closed LMArena score over time."
  lastUpdated={meta.lastUpdated}
>
  <div class="grid gap-8">
    <header class="space-y-2">
      <p class="font-mono m-0 text-[11px] uppercase tracking-[0.16em] text-[var(--muted)]">
        Quality gap · Backfilled from LMArena history
      </p>
      <h1 class="m-0 text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.025em]">
        Open vs closed gap
      </h1>
    </header>

    <OpenVsClosedChart client:load data={data} />
  </div>
</BaseLayout>
