---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProvidersChart from "../components/ProvidersChart";
import { loadMeta, loadProviders } from "../lib/data";

const meta = loadMeta();
const data = loadProviders();
---

<BaseLayout
  title="Provider spread"
  description="Same open-weights LLM priced across inference providers on OpenRouter."
  lastUpdated={meta.lastUpdated}
>
  <div class="grid gap-8">
    <header class="space-y-2">
      <p class="font-mono m-0 text-[11px] uppercase tracking-[0.16em] text-[var(--muted)]">
        Inference market · Open-weights pricing
      </p>
      <h1 class="m-0 text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.025em]">
        Provider spread
      </h1>
    </header>

    <ProvidersChart client:load data={data} />
  </div>
</BaseLayout>
