---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartShell from "../components/ChartShell.astro";
---

<BaseLayout
  title="Provider spread"
  description="Same open model, different providers — price ranges across OpenRouter."
>
  <div class="grid gap-10">
    <header class="space-y-2">
      <h1 class="m-0 text-[clamp(1.75rem,3vw,2.5rem)] font-semibold tracking-[-0.02em]">
        Provider spread
      </h1>
      <p class="m-0 text-[var(--muted)] max-w-2xl">
        Range/dot plot of the same open model priced across providers.
      </p>
    </header>

    <ChartShell
      takeaway="Identical weights, different invoices — shop the range before you lock in."
      keyNumber="—"
      keyNumberLabel="Widest spread"
      source="Source: OpenRouter (openrouter.ai)"
    />
  </div>
</BaseLayout>
